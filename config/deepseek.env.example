# Copy these values into the current PowerShell session. Never commit a real API key.
FUNDOS_LLM_API_KEY=replace-with-your-deepseek-api-key
FUNDOS_LLM_MODEL=deepseek-v4-flash
FUNDOS_LLM_BASE_URL=https://api.deepseek.com
FUNDOS_LLM_PROVIDER=deepseek
FUNDOS_LLM_INPUT_COST_PER_MILLION=0.14
FUNDOS_LLM_OUTPUT_COST_PER_MILLION=0.28
FUNDOS_LLM_MAX_DAILY_COST_USD=1
FUNDOS_LLM_MAX_DAILY_TOKENS=100000
FUNDOS_LLM_CIRCUIT_FAILURE_THRESHOLD=3
